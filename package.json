{
  "name": "yumi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:types": "SUPABASE_STUDIO_AUTH=\"$SUPABASE_STUDIO_AUTH\" python3 scripts/gen-db-types.py",
    "db:migrate": "python3 scripts/migrate.py",
    "db:status": "python3 scripts/migrate.py --status",
    "db:check": "python3 scripts/checks/migraciones_describen_la_base.py",
    "test": "python3 scripts/pruebas/correr.py",
    "test:dinero": "python3 scripts/pruebas/dinero.py",
    "test:publico": "python3 scripts/pruebas/superficie_publica.py",
    "test:navegador": "node scripts/pruebas/navegador.mjs",
    "verify": "npm run typecheck && npm run lint && npm run db:check && npm test"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.58.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "15.5.24",
    "nodemailer": "^9.0.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "playwright": "^1.62.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
