# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://menudb.coolify.kaizencode.me
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role (Studio → Settings → API). SALTA RLS: sólo en servidor,
# nunca con prefijo NEXT_PUBLIC_. Necesaria para invitar empleados y para el
# webhook de Stripe.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
# URL pública real. De ella salen los QR de mesa y los enlaces para compartir;
# si apunta a localhost, los QR impresos no funcionarán.
# URL pública: se usa para construir los QR de mesa y los enlaces de reparto.
NEXT_PUBLIC_SITE_URL=https://yumi.coolify.kaizencode.me

# ---------- Stripe (renovación de suscripciones) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
