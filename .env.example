# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://menudb.coolify.kaizencode.me
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role (Studio → Settings → API). SALTA RLS: sólo en servidor,
# nunca con prefijo NEXT_PUBLIC_. Necesaria para invitar empleados y para el
# webhook de Stripe.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
# URL pública real. De ella salen los QR de mesa y los enlaces para compartir;
# si apunta a localhost, los QR impresos no funcionarán.
# URL pública: se usa para construir los QR de mesa y los enlaces de reparto.
NEXT_PUBLIC_SITE_URL=https://yumi.coolify.kaizencode.me

# ---------- Stripe (renovación de suscripciones) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Correo saliente de la app ----------
# Lo usa la aplicación para sus propios correos (invitaciones de equipo).
# Puerto 465 = TLS directo · puerto 587 = STARTTLS.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=465
SMTP_USER=noreply@tu-dominio.com
SMTP_PASSWORD=
SMTP_FROM=noreply@tu-dominio.com
SMTP_FROM_NAME=Yumi

# Se aceptan también los nombres que usa GoTrue (SMTP_PASS, SMTP_ADMIN_EMAIL,
# SMTP_SENDER_NAME), porque en un mismo despliegue conviven los dos servicios y
# equivocarse de nombre deja el correo mudo sin dar ningún error.

# OJO: los correos de confirmación de registro y recuperación de contraseña NO
# salen de aquí, sino de GoTrue (Supabase Auth). Esas variables van en el
# despliegue de Supabase; ver la sección "Correo" del README.

# Notificaciones push: genera el par con `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@tu-dominio.com
